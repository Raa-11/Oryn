                {
                  "type": "frame",
                  "id": "avQjM",
                  "name": "Evidence is not effort",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "TST5N",
                      "name": "Evidence is not effort",
                      "fill": "#EDF2F6",
                      "content": "Evidence is not effort",
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "b9KRUo",
                      "name": "Separate planned meetings from attended work.",
                      "fill": "#A2ACB8",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Separate planned meetings from attended work.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "fWWMh",
                      "name": "Commit + push + Zed context can be one evidence group.",
                      "fill": "#A2ACB8",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Commit + push + Zed context can be one evidence group.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "spQ5o",
                      "name": "Never infer hours from a Git timestamp or divide equally.",
                      "fill": "#A2ACB8",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Never infer hours from a Git timestamp or divide equally.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "eImMU",
                      "name": "Optional work intervals reveal overlaps; no interval means a manual review is required.",
                      "fill": "#A2ACB8",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Optional work intervals reveal overlaps; no interval means a manual review is required.",
                      "lineHeight": 1.5,
                      "fontFamily": "Inter",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    }
                  ]
                },
