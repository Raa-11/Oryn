load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "core",
    features = ["cpp_modules"],
    module_interfaces = ["app_info.cppm"],
    local_defines = select({
        "//:windows_opt": ["NDEBUG"],
        "//conditions:default": [],
    }),
    # CLion's Bazel aspect omits module_interfaces; expose them without compiling twice.
    textual_hdrs = ["app_info.cppm"],
    visibility = ["//src/app:__pkg__"],
    deps = [],
)

cc_test(
    name = "app_info_test",
    size = "small",
    srcs = ["app_info_test.cpp"],
    local_defines = ["DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN"],
    features = ["cpp_modules"],
    deps = [":core", "@doctest//doctest"],
)
