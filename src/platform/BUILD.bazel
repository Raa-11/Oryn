load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
cc_library(
    name = "window",
    srcs = ["window.cpp"],
    features = ["cpp_modules"],
    module_interfaces = ["window.cppm"],
    local_defines = select({
        "//:windows_opt": ["NDEBUG"],
        "//conditions:default": [],
    }),
    # CLion's Bazel aspect omits module_interfaces; expose them without compiling twice.
    textual_hdrs = ["window.cppm"],
    deps = ["@slint"],
    linkopts = select({"@platforms//os:windows": ["user32.lib", "gdi32.lib", "comctl32.lib", "shell32.lib"], "//conditions:default": []}),
    visibility = ["//src/app:__pkg__"],
)

cc_test(
    name = "window_test",
    size = "small",
    srcs = ["window_test.cpp"],
    features = ["cpp_modules"],
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":window"],
)

