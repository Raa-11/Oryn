load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "database",
    srcs = ["database.cpp"],
    features = ["cpp_modules"],
    module_interfaces = ["database.cppm"],
    textual_hdrs = ["database.cppm"],
    local_defines = select({
        "//:windows_opt": ["NDEBUG"],
        "//conditions:default": [],
    }),
    deps = ["@sqlite3//:sqlite3"],
    visibility = [
        "//src/features/calendar:__pkg__",
        "//src/features/settings:__pkg__",
    ],
)

cc_test(
    name = "database_test",
    srcs = ["database_test.cpp"],
    features = ["cpp_modules"],
    local_defines = ["DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN"],
    deps = [":database", "@doctest//doctest", "@sqlite3//:sqlite3"],
    size = "small",
)
