load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "time",
    srcs = ["timer_service.cpp"],
    features = ["cpp_modules"],
    module_interfaces = ["pomodoro_service.cppm", "timer_state.cppm", "timer_service.cppm"],
    local_defines = select({
        "//:windows_opt": ["NDEBUG"],
        "//conditions:default": [],
    }),
    # CLion's Bazel aspect omits module_interfaces; expose them without compiling twice.
    textual_hdrs = ["pomodoro_service.cppm", "timer_state.cppm", "timer_service.cppm"],
    deps = ["@boost.asio", "@entt"],
    visibility = ["//src/app:__pkg__"],
)
cc_test(
    name = "time_test",
    srcs = ["timer_test.cpp"],
    features = ["cpp_modules"],
    local_defines = ["DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN"],
    deps = [":time", "@doctest//doctest"],
    size = "small",
)
